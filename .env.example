# -----------------------------------------------------------------------------
# Nima Taghavi Portfolio - environment variables
# Copy this file to `.env.local` and fill in real values.
# Never commit `.env.local` or any secret.
# -----------------------------------------------------------------------------

# PostgreSQL connection string.
# Local development: run `npm run db:dev` and paste the printed TCP URL here.
# Production: use a managed Postgres URL (Neon, Supabase, Prisma Postgres, ...).
# Example local value:
# postgresql://postgres:postgres@localhost:51214/template1?sslmode=disable&connection_limit=1
DATABASE_URL=""

# Neon provides a pooled URL (DATABASE_URL) for the application and a direct
# URL (DATABASE_URL_UNPOOLED) for migrations, dumps and replication.
# `neon deploy` / `neon env pull` write both automatically.
DATABASE_URL_UNPOOLED=""

# Only needed by `prisma migrate dev` locally. `prisma dev` exposes a shadow
# database on the next port (usually 51215). Production migrations do not use it.
SHADOW_DATABASE_URL=""

# NextAuth
# In production this MUST be your HTTPS URL (e.g. https://nimataghavi.ir).
# Secure cookies are enabled automatically when this starts with https://.
NEXTAUTH_URL="http://localhost:3000"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=""

# Initial admin account (used once by `npm run db:seed`).
# In development an empty ADMIN_PASSWORD generates a strong password and prints
# it exactly once. In production the first seed requires both values so a
# password is never written to deployment logs. There are no default credentials.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Nima Taghavi"

# Public site URL used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL="https://nimataghavi.ir"

# Optional email notifications for the contact form.
# Leave empty to keep email delivery disabled; messages are still stored in Postgres.
RESEND_API_KEY=""
CONTACT_NOTIFY_EMAIL=""
CONTACT_FROM_EMAIL="Portfolio Contact <onboarding@resend.dev>"

# Optional: only used by deployment tooling.
# VERCEL_URL is provided automatically on Vercel.
